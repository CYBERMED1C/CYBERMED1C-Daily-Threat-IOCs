union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| extend RemoteHost = tolower(tostring(parse_url(iff(RemoteUrl contains "://", RemoteUrl, strcat("https://", RemoteUrl))).Host))
| where RemoteHost in (DomainIOCs)
    or RemoteUrl in (URLIOCs)
    or (RemoteIP in (IPIOCs) and (RemoteIP != "153.75.82.159" or RemotePort in (8080)) and (RemoteIP != "185.232.84.169" or RemotePort in (8041)) and (RemoteIP != "193.57.9.155" or RemotePort in (4912)) and (RemoteIP != "213.136.79.115" or RemotePort in (8000, 4444)) and (RemoteIP != "91.99.195.164" or RemotePort in (8888)))
| project Timestamp, DeviceName, ActionType, RemoteIP, RemotePort, RemoteUrl, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId
),
(
DeviceFileEvents
| where Timestamp >= ago(30d)
| where tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceName, ActionType, FileName, FolderPath, SHA1, SHA256, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceName, ActionType, FileName, FolderPath, SHA1, SHA256, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId
)
| top 500 by Timestamp desc
