union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| extend RemoteHost = tolower(tostring(parse_url(iff(RemoteUrl contains "://", RemoteUrl, strcat("http://", RemoteUrl))).Host))
| where RemoteHost in (DomainIOCs) or RemoteIP in (IPIOCs) or RemoteUrl in (URLIOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName = InitiatingProcessFileName, RemoteIP, RemoteUrl, InitiatingProcessFileName
),
(
DeviceFileEvents
| where Timestamp >= ago(30d)
| where tolower(MD5) in (MD5IOCs) or tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, FolderPath, MD5, SHA1, SHA256, InitiatingProcessFileName
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where tolower(MD5) in (MD5IOCs) or tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, FolderPath, MD5, SHA1, SHA256, InitiatingProcessFileName
)
| top 500 by Timestamp desc
