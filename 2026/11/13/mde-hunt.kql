union
(DeviceNetworkEvents
| where Timestamp >= ago(30d)
| extend RemoteHost = tolower(tostring(parse_url(iff(RemoteUrl contains "://", RemoteUrl, strcat("https://", RemoteUrl))).Host))
| where RemoteHost in (DomainIOCs)
    or RemoteUrl in (URLIOCs)
    or (RemoteIP in (IPIOCs) and (RemoteIP != "157.20.241.16" or (RemotePort == 8080 or RemotePort between (19202 .. 19418))) and (RemoteIP != "89.125.213.123" or (RemotePort == 8080 or RemotePort == 46125)) and (RemoteIP != "87.199.205.61" or (RemotePort == 443)) and (RemoteIP != "171.22.131.24" or (RemotePort == 8133)))
| project Timestamp, DeviceName, ActionType, RemoteIP, RemotePort, RemoteUrl, FileName=InitiatingProcessFileName, Evidence="network"
),
(DeviceFileEvents
| where Timestamp >= ago(30d)
| where tolower(MD5) in (MD5IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceName, ActionType, FileName, FolderPath, MD5, SHA256, Evidence="hash"
),
(DeviceProcessEvents
| where Timestamp >= ago(30d)
| where tolower(MD5) in (MD5IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceName, ActionType, FileName, FolderPath, MD5, SHA256, Evidence="hash"
)
| top 500 by Timestamp desc
