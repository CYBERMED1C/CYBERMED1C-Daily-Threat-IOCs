| where tolower(MD5) in (MD5IOCs) or tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, EventKind = "File", RemoteIP = FileOriginIP, RemoteUrl = FileOriginUrl, FileName, SHA256, SHA1, MD5
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where tolower(MD5) in (MD5IOCs) or tolower(SHA1) in (SHA1IOCs) or tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, EventKind = "Process", RemoteIP = "", RemoteUrl = "", FileName, SHA256, SHA1, MD5
