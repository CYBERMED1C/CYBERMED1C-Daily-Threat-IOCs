union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| extend RemoteHost = tolower(tostring(parse_url(iff(RemoteUrl contains "://", RemoteUrl, strcat("http://", RemoteUrl))).Host))
| where RemoteHost in (DomainIOCs) or RemoteIP in (IPIOCs) or RemoteUrl in (URLIOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, RemoteIP, RemoteUrl, InitiatingProcessFileName
),
(
DeviceFileEvents
| where Timestamp >= ago(30d)
| where tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, FolderPath, SHA256, InitiatingProcessFileName
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where tolower(SHA256) in (SHA256IOCs)
| project Timestamp, DeviceId, DeviceName, ActionType, FileName, FolderPath, SHA256, InitiatingProcessFileName
),
(
CloudAppEvents
| where Timestamp >= ago(30d)
| where Application == "Amazon Web Services"
| where IPAddress in (AWSSourceIPIOCs)
| project Timestamp, Application, ActionType, IPAddress, ObjectName, ObjectType
)
| top 500 by Timestamp desc
